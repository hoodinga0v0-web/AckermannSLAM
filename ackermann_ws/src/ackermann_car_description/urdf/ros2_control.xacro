<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ackermann_ros2_control" params="controllers_file">
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="rear_right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">${-rear_right_wheel_velocity}</param>
          <param name="max">${rear_right_wheel_velocity}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="rear_left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">${-rear_left_wheel_velocity}</param>
          <param name="max">${rear_left_wheel_velocity}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="front_right_steering_joint">
        <command_interface name="position">
          <param name="min">${front_right_steering_lower}</param>
          <param name="max">${front_right_steering_upper}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="front_left_steering_joint">
        <command_interface name="position">
          <param name="min">${front_left_steering_lower}</param>
          <param name="max">${front_left_steering_upper}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="front_right_wheel_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="front_left_wheel_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <gazebo>
      <plugin
        filename="libgz_ros2_control-system.so"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
        <position_proportional_gain>${steering_position_gain}</position_proportional_gain>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
