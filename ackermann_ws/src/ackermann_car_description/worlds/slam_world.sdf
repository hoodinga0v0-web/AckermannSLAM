<?xml version="1.0"?>
<sdf version="1.10">
  <world name="slam_world">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.72 0.78 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -1.0</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static>
      <pose>0 6 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.2 2</size></box></geometry>
          <material><ambient>0.70 0.70 0.73 1</ambient><diffuse>0.80 0.80 0.83 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-6 0.5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 11 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 11 2</size></box></geometry>
          <material><ambient>0.70 0.70 0.73 1</ambient><diffuse>0.80 0.80 0.83 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_short_wall">
      <static>true</static>
      <pose>-2.25 -5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>7.5 0.2 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>7.5 0.2 2</size></box></geometry>
          <material><ambient>0.70 0.70 0.73 1</ambient><diffuse>0.80 0.80 0.83 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>6 1.5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 9 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 9 2</size></box></geometry>
          <material><ambient>0.70 0.70 0.73 1</ambient><diffuse>0.80 0.80 0.83 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="inner_l_wall_long">
      <static>true</static>
      <pose>1.0 1.5 0.75 0 0 0.25</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.2 0.18 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.2 0.18 1.5</size></box></geometry>
          <material><ambient>0.45 0.58 0.72 1</ambient><diffuse>0.50 0.64 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="inner_l_wall_short">
      <static>true</static>
      <pose>2.97 2.27 0.75 0 0 0.25</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0.9 0 0 0 0</pose>
          <geometry><box><size>0.18 1.8 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0.9 0 0 0 0</pose>
          <geometry><box><size>0.18 1.8 1.5</size></box></geometry>
          <material><ambient>0.45 0.58 0.72 1</ambient><diffuse>0.50 0.64 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="round_column">
      <static>true</static>
      <pose>-2.8 2.0 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.38</radius><length>1.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.38</radius><length>1.8</length></cylinder></geometry>
          <material><ambient>0.75 0.45 0.25 1</ambient><diffuse>0.85 0.52 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="square_column">
      <static>true</static>
      <pose>3.7 -2.0 0.75 0 0 0.35</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.7 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 1.5</size></box></geometry>
          <material><ambient>0.35 0.65 0.38 1</ambient><diffuse>0.40 0.75 0.44 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="asymmetric_landmark">
      <static>true</static>
      <pose>-1.5 -2.6 0 0 0 -0.4</pose>
      <link name="link">
        <collision name="base_collision">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>1.2 0.35 0.6</size></box></geometry>
        </collision>
        <visual name="base_visual">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry><box><size>1.2 0.35 0.6</size></box></geometry>
          <material><ambient>0.65 0.25 0.25 1</ambient><diffuse>0.80 0.30 0.30 1</diffuse></material>
        </visual>
        <collision name="upright_collision">
          <pose>-0.42 0 1.0 0 0 0</pose>
          <geometry><box><size>0.35 0.35 1.4</size></box></geometry>
        </collision>
        <visual name="upright_visual">
          <pose>-0.42 0 1.0 0 0 0</pose>
          <geometry><box><size>0.35 0.35 1.4</size></box></geometry>
          <material><ambient>0.65 0.25 0.25 1</ambient><diffuse>0.80 0.30 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
